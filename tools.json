{
  "$schema": "https://flykit.cc/schemas/tools.json",
  "name": "flykit-registry",
  "description": "Tools and plugins across ecosystems — Claude Code companions, DeepSeek Harness plugins, macOS apps",
  "owner": {
    "name": "kaiomp"
  },
  "tools": [
    {
      "name": "ghostcode",
      "slug": "ghostcode",
      "description": "Ghostty launcher for Claude Code — project picker, per-project tints, model/provider/mode switcher.",
      "repo": "https://github.com/flykit-cc/ghostcode",
      "npm": "@flykit/ghostcode",
      "install": "git clone https://github.com/flykit-cc/ghostcode && npm install -g ./ghostcode",
      "category": "workflow",
      "keywords": [
        "ghostty",
        "launcher",
        "picker"
      ],
      "license": "MIT",
      "version": "0.2.0",
      "web": "./tools/ghostcode/web.json",
      "ecosystem": "claude-code"
    },
    {
      "name": "dsh-claude-live",
      "slug": "dsh-claude-live",
      "ecosystem": "dsh",
      "description": "Run Claude Code as a subagent inside DeepSeek Harness, with its steps streaming live into the session view.",
      "repo": "https://github.com/flykit-cc/dsh-claude-live",
      "npm": "dsh-claude-live",
      "install": "dsh plugin --profile web add dsh-claude-live",
      "category": "agents",
      "keywords": [
        "deepseek-harness",
        "cordis",
        "claude-code",
        "subagent"
      ],
      "license": "MIT",
      "version": "0.1.1",
      "web": "./tools/dsh-claude-live/web.json"
    },
    {
      "name": "dsh-flykit",
      "slug": "dsh-flykit",
      "ecosystem": "dsh",
      "description": "flykit for DeepSeek Harness — explorer with live file watch, agent terminals (Claude Code, Pi, Codex), DSH agent tools, searchable model picker, Claude usage bars and a status line. Fly your agents.",
      "repo": "https://github.com/flykit-cc/dsh-flykit",
      "install": "dsh plugin --profile web add dsh-flykit",
      "category": "agents",
      "keywords": [
        "dsh-plugin",
        "deepseek-harness",
        "cordis",
        "claude-code",
        "terminal",
        "file-editor",
        "statusline"
      ],
      "license": "MIT",
      "version": "0.1.0",
      "web": "./tools/dsh-flykit/web.json",
      "npm": "dsh-flykit"
    },
    {
      "name": "uisper",
      "slug": "uisper",
      "ecosystem": "macos",
      "description": "Native, fully local dictation for macOS. Hold a key, speak, let go: on-device speech to text and AI cleanup, inserted into any app.",
      "repo": "https://github.com/flykit-cc/uisper",
      "install": "https://github.com/flykit-cc/uisper/releases/latest",
      "category": "productivity",
      "keywords": [
        "macos",
        "dictation",
        "speech-to-text",
        "apple-intelligence",
        "local"
      ],
      "license": "MIT",
      "version": "0.1.0",
      "web": "./tools/uisper/web.json"
    }
  ]
}
